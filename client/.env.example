# ── GroundTruth client environment variables ─────────────────────────────────
# Copy this file to .env.local for local development.
# In AWS Amplify, set these under App settings → Environment variables.

# Base URL of the API Gateway stage (no trailing slash).
# After `sam deploy`, this is printed as the "ApiUrl" output.
# Example: https://abc123.execute-api.ap-south-1.amazonaws.com/prod
VITE_API_BASE_URL=http://localhost:8000

# API Gateway API Key for the admin panel.
# Create one in AWS Console → API Gateway → API Keys, then associate it
# with the GroundTruth usage plan.
# If set at build time the admin panel skips the login screen.
# Leave blank to prompt for the key at runtime (recommended for production).
VITE_ADMIN_API_KEY=

# CloudFront / S3 CDN hostname for serving issue photos (no https://).
# Example: d1abc123.cloudfront.net
# Leave blank if photos are served directly from S3 (not recommended).
VITE_PHOTOS_CDN=
